{
  "name": "pi-context-curator",
  "version": "0.1.0",
  "description": "Human-in-the-loop semantic context curation for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reindeer-AI/pi-context-curator.git"
  },
  "homepage": "https://github.com/Reindeer-AI/pi-context-curator#readme",
  "bugs": {
    "url": "https://github.com/Reindeer-AI/pi-context-curator/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "context-management",
    "compaction"
  ],
  "files": [
    "src",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "tsx scripts/render-screenshots.ts",
    "verify": "npm run check && npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typebox": "1.1.38",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "undici": "8.12.2"
  }
}
